# ============ dorm-sign-auto 配置示例 ============
# 复制为 .env 并填写真实值；未配置的密钥会尝试从 legacy/config.json 迁移，
# 仍缺失时自动生成并回写 .env。

# 服务器监听
HOST=0.0.0.0
PORT=8805

# 数据库（SQLite 异步，WAL 模式）
# DATABASE_URL=sqlite+aiosqlite:///./data/dorm_sign.db

# 安全密钥（务必改为随机值；生产环境请从旧 config.json 迁移以兼容既有加密数据）
SECRET_KEY=
DORM_PASSWORD_ENCRYPT_KEY=
TOKEN_TTL_DAYS=30
MAX_LOGIN_PER_MINUTE=30

# 意见反馈管理后台口令；留空时 /api/admin/* 一律返回 403
ADMIN_TOKEN=

# 晚寝上游
DORM_BASE_URL=https://xskq.ahut.edu.cn
DORM_TASK_ID=
DORM_ENABLE_API_LOG=true

# 调度器（默认关闭：延续"签到已停止使用"的决定；需要恢复时改为 true）
SCHEDULER_ENABLED=false
SCHEDULER_SCAN_INTERVAL_SECONDS=20
SCHEDULER_MAX_CONCURRENT=5

# CORS 白名单（逗号分隔；留空表示仅同源；填 * 表示允许任意来源，此时不携带凭证）
# CORS_ORIGINS=https://example.com
CORS_ORIGINS=*
